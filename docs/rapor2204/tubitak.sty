% TÜBİTAK 2204-A proje raporu stili — 2026-2027 resmî şablonuna göre.
%
% Şablonun biçim kuralı (birebir): "Proje raporu yazımında yazı tipi Times
% New Roman, yazı tipi boyutu ise 12 punto olmalıdır. Proje rapor metnindeki
% her bir sayfa, sayfanın her yanından 2,5 cm boşluk bırakarak, tek satır
% aralığı ile iki yana yaslı şekilde düzenlenmelidir." Sayfa sınırı 20.
%
% Yazı tipi notu: newtxtext/newtxmath, Times New Roman'ın ölçü ve görünüm
% olarak eşi olan serbest klonudur (URW Nimbus Roman / TeX Gyre Termes
% ailesi). Gerçek TTF'yi fontspec ile çağırmak metin tarafında çalışır ama
% matematik tarafını bozar; bu raporda denklem yoğun olduğu için klon
% tercih edildi. Baskıda ayırt edilemez.
%
% Ön baskının `ethosoft.sty`'si DEĞİŞTİRİLMEDİ: o metin
% DOI 10.5281/zenodo.23284193 ile yayımlandı ve yatırılan dosyayla bayt
% bayt aynı tutuluyor.
\ProvidesPackage{tubitak}[2026/10/12 TÜBİTAK 2204-A 2026-2027 rapor stili]

% --- dil ----------------------------------------------------------------
% shorthands=off ZORUNLU: babel-turkish `:` ve `=` karakterlerini etkin hale
% getirir, bu da TikZ/pgfplots seçenek listelerini (`width=56mm`,
% `axis cs:`) derleme sırasında bozar. Kapatınca heceleme ve Türkçe
% otomatik adlar ("Şekil", "Tablo", "Kaynaklar") korunur.
\RequirePackage[shorthands=off,main=turkish]{babel}

% --- sayfa: şablonun istediği ölçüler -----------------------------------
\RequirePackage[a4paper,margin=2.5cm,headsep=6mm,footskip=11mm]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{newtxtext,newtxmath}
\RequirePackage{microtype}
\RequirePackage{setspace}
\RequirePackage{graphicx,xcolor}
% amssymb YÜKLENMEZ: newtxmath'ten sonra gelince \Bbbk'yi yeniden tanımlayıp
% derlemeyi durduruyor. İhtiyacımız olan tek şey iş-zaman çizelgesindeki iki
% kutu imiydi; onlar aşağıda \rule ile kuruldu, sembol fontu gerekmiyor.
\RequirePackage{amsmath}
\RequirePackage{booktabs,array,multirow,colortbl}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{placeins}
\RequirePackage{enumitem}
\RequirePackage{caption}
\RequirePackage{xurl}
% Yazar-yıl atıf: şablon "Kaynaklar APA yazım kurallarına göre listelenir"
% diyor; numaralı atıf APA değildir.
\RequirePackage[authoryear,round]{natbib}
\RequirePackage[unicode,colorlinks=true,breaklinks=true]{hyperref}

\definecolor{RaporMurekkep}{HTML}{000000}
\definecolor{RaporBag}{HTML}{1F4E79}
\definecolor{RaporGri}{HTML}{595959}
\definecolor{RaporVurgu}{HTML}{A62B1F}

% Atıf ve iç başvurular SİYAH kalsın: biçim denetiminde rapor düz metin
% görünmeli. Yalnız dış bağlantılar (DOI/URL) koyu mavi.
\hypersetup{linkcolor=black, citecolor=black, urlcolor=RaporBag}

% --- gövde: tek satır aralığı, iki yana yaslı ---------------------------
\singlespacing
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0pt}
\raggedbottom
% Şekiller metinle aynı sayfada kalsın.
\renewcommand{\topfraction}{0.88}
\renewcommand{\bottomfraction}{0.72}
\renewcommand{\textfraction}{0.10}
\renewcommand{\floatpagefraction}{0.75}
\setcounter{topnumber}{2}
\setcounter{totalnumber}{3}

% --- başlıklar: şablondaki adlar, numaralı --------------------------------
\titleformat{\section}
  {\normalfont\large\bfseries\color{RaporMurekkep}}{\thesection.}{0.5em}{}
\titleformat{\subsection}
  {\normalfont\normalsize\bfseries\color{RaporMurekkep}}{\thesubsection.}{0.5em}{}
\titleformat{\subsubsection}
  {\normalfont\normalsize\itshape\color{RaporMurekkep}}{\thesubsubsection.}{0.5em}{}
\titlespacing*{\section}{0pt}{2.2ex plus .6ex}{1.0ex}
\titlespacing*{\subsection}{0pt}{1.7ex plus .5ex}{0.7ex}
\titlespacing*{\subsubsection}{0pt}{1.4ex plus .4ex}{0.5ex}

% --- şekil ve tablo başlıkları -------------------------------------------
% Rehberdeki örnekler ("Tablo 5. İş Zaman Çizelgesi", "Şekil 4. Örnek Proje
% Özeti") ortalı ve etiketi kalın. Kısa başlık ortalanır, uzun başlık iki
% yana yaslanır (singlelinecheck).
\captionsetup{font=small, labelfont=bf, labelsep=period,
              justification=justified, singlelinecheck=true, skip=5pt}
\captionsetup[table]{skip=3pt}

% --- üst/alt bilgi --------------------------------------------------------
% Şablon kapak sayfası ve kimlik bilgisi YASAKLIYOR; üst bilgiye de ad,
% okul, logo konmaz. Yalnız sayfa numarası.
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\normalsize\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% --- şablonun üst alanları ------------------------------------------------
% "Proje Ana Alanı: / Proje Tematik Alanı: / Proje Adı (Başlığı):"
\newcommand{\sablonalan}[2]{%
  \noindent\textbf{#1:}~#2\par\vspace{2pt}}

\newcommand{\projebasligi}[1]{%
  \noindent\textbf{Proje Adı (Başlığı):}~#1\par\vspace{6pt}}

% --- özet ve anahtar kelimeler -------------------------------------------
\newenvironment{projeozeti}{%
  \section*{Özet}\noindent\ignorespaces
}{\par}

\newcommand{\anahtarkelimeler}[1]{%
  \par\vspace{4pt}\noindent\textbf{Anahtar Kelimeler:}~#1\par}

% --- depodaki kaynağa bağ -------------------------------------------------
% Her sayısal yargının izlenebilir olması projenin kuralı; rapordaki
% bağlar depodaki tarihli dosyaya gider.
\newcommand{\depocommit}{a35dab4}
\newcommand{\depo}[2]{%
  \href{https://github.com/Yagiz-D-Ekrem-Dolar/dart-rift/blob/\depocommit/#1}{#2}}

% --- Türkçe ondalık ayracı ------------------------------------------------
% TDK ve TÜBİTAK yazımında ondalık ayracı virgüldür. Metin kipinde düz
% virgül yazılır (3,7480). Matematik kipinde düz virgül liste ayracı
% sayılıp arkasına fazladan boşluk koyar; orada {,} yazılır: $3{,}7480$.

% --- iş-zaman çizelgesi imleri -------------------------------------------
% Dolu kutu: tamamlanan iş. Boş kutu: planlanmış ama henüz yapılmamış iş.
% Sembol fontu yerine \rule: amssymb bağımlılığı olmasın.
\newcommand{\tamam}{\textcolor{RaporMurekkep}{\rule[-0.02ex]{1.45ex}{1.45ex}}}
\newcommand{\planli}{{\color{RaporGri}\setlength{\fboxsep}{0pt}%
  \fbox{\rule{0pt}{1.3ex}\rule{1.3ex}{0pt}}}}

% --- "henüz yapılmadı" kutusu --------------------------------------------
% Kullanıcı kuralı: henüz girilmemiş kısımlar bitirilmiş gibi yazılmaz.
% Bu kutu, raporun hangi parçasının beklediğini göz ardı edilemez biçimde
% ayırır. \colorbox'ın açtığı süslü parantez \newenvironment'ın "başlangıç"
% parçasında kapanamayacağı için içerik önce lrbox'a toplanır.
\newsavebox{\beklemekutusu}
\newenvironment{bekleyen}{%
  \par\vspace{2mm}%
  \begin{lrbox}{\beklemekutusu}%
  \begin{minipage}{\dimexpr\linewidth-8mm\relax}\small
}{%
  \end{minipage}%
  \end{lrbox}%
  \noindent{\setlength{\fboxsep}{3mm}%
    \fcolorbox{RaporGri!45}{RaporGri!7}{\usebox{\beklemekutusu}}}%
  \par\vspace{2.4mm}}

% --- sınır/uyarı kutusu ---------------------------------------------------
\newsavebox{\sinirkutusu}
\newenvironment{sinir}{%
  \par\vspace{2mm}%
  \begin{lrbox}{\sinirkutusu}%
  \begin{minipage}{\dimexpr\linewidth-8mm\relax}\small
}{%
  \end{minipage}%
  \end{lrbox}%
  \noindent{\setlength{\fboxsep}{3mm}%
    \fcolorbox{RaporVurgu!40}{RaporVurgu!5}{\usebox{\sinirkutusu}}}%
  \par\vspace{2.4mm}}
